<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Leaps Quick Record" android:textSize="26sp" android:textStyle="bold" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Backend URL" />
  <EditText android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="https://carlevato.net/leaps" android:inputType="textUri" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Widget background" />
  <Spinner android:id="@+id/transparency" android:layout_width="match_parent" android:layout_height="wrap_content" />
  <Button android:id="@+id/save" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save connection" />
  <Button android:id="@+id/enable_reminders" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Enable pill reminders" />
  <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
</LinearLayout>
