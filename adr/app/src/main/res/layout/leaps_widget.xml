<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_shell" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="6dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <LinearLayout android:id="@+id/medium" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/widget_action_background" android:gravity="center" android:orientation="vertical" android:padding="4dp">
      <ImageView android:layout_width="23dp" android:layout_height="23dp" android:contentDescription="Medium read" android:src="@drawable/ic_article" android:tint="#FFFFFF" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Medium" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/morning_pills" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/widget_action_background" android:gravity="center" android:orientation="vertical" android:padding="4dp">
      <ImageView android:layout_width="23dp" android:layout_height="23dp" android:contentDescription="D3, O3, and Creatine taken" android:src="@drawable/ic_sun" android:tint="#FFFFFF" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Morning" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/evening_pills" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/widget_action_background" android:gravity="center" android:orientation="vertical" android:padding="4dp">
      <ImageView android:layout_width="23dp" android:layout_height="23dp" android:contentDescription="Magnesium taken" android:src="@drawable/ic_moon" android:tint="#FFFFFF" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Magnesium" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="center" android:text="Ready" android:textColor="#D9E5DF" android:textSize="10sp" />
</LinearLayout>
